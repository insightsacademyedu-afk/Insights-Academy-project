# The existing academy uses test. Do not rename your live database.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.example.mongodb.net/test?retryWrites=true&w=majority
BACKUP_DB=test
BACKUP_DIR=./backup/backups
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_AGE_HOURS=26
UPLOAD_TO_CLOUD=false
RCLONE_REMOTE=academy-backups
RCLONE_PATH=academy-management
CLOUD_RETENTION_DAYS=30
# Optional absolute executable paths; useful when Task Scheduler has a different PATH.
# MONGODUMP_BIN=C:/Program Files/MongoDB/Tools/100/bin/mongodump.exe
# MONGORESTORE_BIN=C:/Program Files/MongoDB/Tools/100/bin/mongorestore.exe
# RCLONE_BIN=C:/Tools/rclone/rclone.exe
