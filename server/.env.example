NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Copy your MongoDB Atlas driver URI here.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.example.mongodb.net/test?retryWrites=true&w=majority

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=ams_token

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeThisPassword123!

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@yourschool.example
